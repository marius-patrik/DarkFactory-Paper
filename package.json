{
  "name": "darkfactory-paper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "publication": "bun scripts/publication.ts",
    "web:build": "bun --cwd web run build",
    "web:check": "bun --cwd web run check",
    "web:acceptance": "bun --cwd web run acceptance",
    "build": "bun run publication && bun run web:build",
    "check": "bun run publication && bun run web:check",
    "site:assemble": "bun scripts/site.ts",
    "site": "bun run build && bun run site:assemble",
    "clean": "rm -rf out site web/dist"
  },
  "devDependencies": {
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  }
}
